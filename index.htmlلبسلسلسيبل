 if(target.questions.some(hasContent)&&!confirm('استبدال أسئلة '+modelTitle(target)+' بنسخة من '+modelTitle(source)+'؟'))return;
 target.questions=JSON.parse(JSON.stringify(source.questions));target.reserveQuestions=JSON.parse(JSON.stringify(source.reserveQuestions||[]));target.name=modelTitle(target);switchModel(state.models.indexOf(target));showStep(2);notice('نُسخت الأسئلة كما هي إلى '+modelTitle(target)+'. يمكنك تعديل النسخة الآن، مع بقاء الأصل محفوظًا.');
