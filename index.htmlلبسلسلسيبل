 const notes=[];if(c?.issues.includes('duplicate_codes'))notes.push('وردت رموز مكررة في التوصيف؛ أُبقيت كما هي، وتُميَّز النواتج بالنص والمجال.');if(c?.issues.includes('missing_codes'))notes.push('ورد ناتج بلا رمز في التوصيف؛ يظهر بلا رقم بدل إسناد رقم جديد إليه.');
 $('numberingNote').textContent=notes.join(' ');$('numberingNote').hidden=!notes.length;
 $('courseOutcomeSidebar').hidden=!c;$('genericGuide').hidden=!!c;$('sidebarCourseTitle').textContent=c?c.title:'';
