function questionIssues(q){const issues=[];if(!line(q.text))issues.push('نص السؤال');if(q.clo&&getOutcome(q.clo)&&!outcomeReady(q.clo))issues.push('ناتج مرتبط غير محدد ضمن نواتج الاختبار');else if(!outcomeReady(q.clo))issues.push(q.sourceClo&&currentCourse()?.outcomes.filter(o=>o.code===q.sourceClo).length>1?'ناتج التعلم: الرمز '+esc(q.sourceClo)+' مكرر، اختر النص المناسب':'ناتج التعلم');if(!letters.includes(q.answer))issues.push('الإجابة الصحيحة');if(q.options.some(o=>!line(o))||new Set(q.options.map(line)).size!==4)issues.push('الخيارات');return issues;}
function renderReview(){
 $('tabs').innerHTML=state.models.map((m,i)=>m.enabled===false?'':`<button role="tab" data-model="${i}" aria-selected="${i===state.active}" class="${i===state.active?'active':''}">${esc(modelTitle(m))}</button>`).join('');$('modelName').value=activeModel().name;$('deleteModel').disabled=false;$('addQuestion').textContent='الانتقال إلى السؤال الفارغ التالي';$('addQuestion').disabled=!activeModel().questions.some(q=>!hasContent(q));renderModelPickers();renderPairStatus();
