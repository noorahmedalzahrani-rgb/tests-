function updateProgress(){$('addQuestion').disabled=!activeModel().questions.some(q=>!hasContent(q));renderPairStatus();const qs=activeModel().questions;const missing=qs.filter(q=>questionIssues(q).length).length;$('reviewStatus').innerHTML=`<span><strong>${qs.filter(q=>!questionIssues(q).length).length} / ${requiredCount()}</strong> أسئلة مكتملة</span><span class="${missing?'pending':'complete'}">${missing?missing+' أسئلة تحتاج إكمالًا':'✓ جميع الأسئلة مكتملة'}</span>`;}
function updateBulk(){const previous=$('bulkClo').value;$('bulkClo').innerHTML=optionsHTML(previous,'اختر الناتج للمجموعة');$('selectedCount').textContent=selected.size?'تم تحديد '+selected.size+' أسئلة':'حدد أسئلة لربطها معًا';$('applyBulk').disabled=!selected.size;$('selectAll').checked=!!activeModel().questions.length&&selected.size===activeModel().questions.length;$('selectAll').indeterminate=selected.size>0&&selected.size<activeModel().questions.length;}
function switchModel(i){state.active=i;selected.clear();expanded.clear();save();renderReview();renderExport();}
function addImported(groups){
 for(const group of groups)if(group.questions.length!==requiredCount())throw new Error('عدد أسئلة '+(group.name||'الملف')+' هو '+group.questions.length+'؛ '+EXAM_TYPES[state.examType].label+' يتطلب '+requiredCount()+' سؤالًا لكل نموذج. صحح الملف أو غيّر نوع الاختبار. لم تتغير الأسئلة الحالية.');
 if(groups.length>3)throw new Error('يمكن استيراد حتى ثلاثة ملفات في المرة الواحدة.');const priorCount=state.settings.modelCount,priorActive=state.active;
 if(groups.length>1&&groups.length>enabledModels().length)normaliseModels(groups.length);
 const targets=groups.length===1?[activeModel()]:enabledModels().slice(0,groups.length);
 const populated=targets.filter(m=>m.questions.some(hasContent));if(populated.length&&!confirm('سيُستبدل محتوى '+populated.map(modelTitle).join(' و')+' بأسئلة الملف. متابعة؟')){normaliseModels(priorCount);state.active=priorActive;renderModelPickers();return false;}
 groups.forEach((group,i)=>{const model=targets[i];model.questions=group.questions;model.reserveQuestions=[];if(group.name)model.name=group.name;for(const q of group.questions){q.sourceClo=q.clo;q.clo=sourceCodeId(q.sourceClo);}});
 state.active=state.models.indexOf(targets[0]);selected.clear();expanded.clear();save();hydrate();showStep(2);notice('تمت تعبئة '+targets.map(modelTitle).join(' و')+' من الملف. راجع الأسئلة والإجابات والنواتج.');return true;
}
function copyModel(source,target){
