 $('questions').innerHTML=rows.map(({q,i})=>{const issues=questionIssues(q);return `<article class="question-row ${issues.length?'needs-review':''}" data-q="${i}"><div class="question-summary"><label class="q-select"><input type="checkbox" data-select="${i}" ${selected.has(i)?'checked':''} aria-label="تحديد السؤال ${i+1}"><span>${i+1}</span></label><div class="q-title"><p>${esc(q.text||'سؤال جديد — أدخل نص السؤال')}</p><span class="q-state">${issues.length?'أكمل: '+issues.join('، '):'✓ مكتمل'}</span></div><button class="edit-button" data-expand="${i}" aria-expanded="${expanded.has(i)}">${expanded.has(i)?'إغلاق':'تعديل'}</button></div><div class="question-detail" ${expanded.has(i)?'':'hidden'}><label>نص السؤال<textarea rows="2" data-field="text" aria-label="نص السؤال ${i+1}">${esc(q.text)}</textarea></label><div class="choices">${q.options.map((v,j)=>`<label><span>الخيار ${arabic[j]}</span><input data-option="${j}" value="${esc(v)}" aria-label="السؤال ${i+1} الخيار ${arabic[j]}" placeholder="نص الخيار"></label>`).join('')}</div><button class="text-button danger" data-delete-q="${i}">تفريغ السؤال</button></div><div class="question-mapping"><label>ناتج التعلم<select data-field="clo" aria-label="ناتج التعلم للسؤال ${i+1}">${optionsHTML(q.clo)}</select></label><label>الإجابة الصحيحة<select data-field="answer" aria-label="الإجابة الصحيحة للسؤال ${i+1}"><option value="">اختر الإجابة</option>${letters.map((l,j)=>`<option value="${l}" ${q.answer===l?'selected':''}>${arabic[j]} — ${esc(q.options[j]||'الخيار '+arabic[j])}</option>`).join('')}</select></label></div></article>`;}).join('')||'<p class="empty-hint">'+(missing?'كل الأسئلة مكتملة ✓':'أضف سؤالًا أو ارفع ملف أسئلة.')+'</p>';
