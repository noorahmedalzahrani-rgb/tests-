  if(course?.outcomes.some(o=>o.id===q.clo))continue;
  const prior=previous.find(o=>(o.id||o.code)===q.clo);
  const exact=prior?course?.outcomes.filter(o=>o.code===prior.code&&o.text===prior.text)||[]:[];
  q.clo=exact.length===1?exact[0].id:'';
 }
 state.outcomes=course?course.outcomes.map(o=>({...o})):[];
 state.selectedOutcomeIds=course?(Array.isArray(state.selectedOutcomeIds)?state.selectedOutcomeIds.filter(id=>course.outcomes.some(o=>o.id===id)):course.outcomes.map(o=>o.id)):[];
