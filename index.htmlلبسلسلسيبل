}
function exportFiles(models,asZip){
 if(!currentCourse()){showStep(2);notice('اختر المقرر أولًا ليُحفظ اسم الملف وبياناته بصورة صحيحة.',true);$('reviewCourse').focus();return;}
 if(!line(state.meta.exam)||!line(state.meta.date)){showStep(1);notice('أكمل عنوان الاختبار والتاريخ لتسمية الملفات.',true);$(line(state.meta.exam)?'date':'exam').focus();return;}
 const errors=validate(models,'aiken');if(errors.length)return showIssue(errors);
 const records=models.map(makeExportRecord);let bytes,name,type;
 if(asZip){const manifest={attribution:ATTRIBUTION,generatedAt:new Date().toISOString(),format:'Aiken UTF-8',files:records.map(r=>({filename:r.filename,...r.metadata}))};bytes=ExamZip.zipStored([...records.map(r=>({name:r.filename,text:r.content})),{name:'بيانات_النماذج_وحقوق_الأداة.json',text:JSON.stringify(manifest,null,2)}]);name=fileStem({name:'',letter:models.map(m=>m.letter).join('-'),section:models.map(m=>line(m.section)).filter(Boolean).join('-')})+'_models.zip';type='application/zip';}else{bytes=records[0].content;name=records[0].filename;type='text/plain;charset=utf-8';}
 const stored=rememberExports(records);download(bytes,name,type);toast(stored?'تم تنزيل الملفات وحفظ نسخة في سجل ملفات آيكن.':'تم تنزيل الملف، وتعذّر حفظ نسخة في هذا المتصفح. احتفظ بالملف المنزّل.');
}
function download(content,name,type='text/plain;charset=utf-8'){const url=URL.createObjectURL(new Blob([content],{type}));const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);}
