function syncCourse(){
 const previous=state.outcomes||[];
 let course=CATALOGUE.find(c=>c.id===state.courseId);
 if(!course){const matches=CATALOGUE.filter(c=>(line(c.title)===line(state.meta.course)||line(c.sourceTitle)===line(state.meta.course)));if(matches.length===1)course=matches[0];}
