async function importFiles(files){const list=Array.from(files);if(!list.length)return;$('uploadBtn').disabled=true;notice('جارٍ قراءة الملفات وترتيب الأسئلة…');try{const groups=[];for(const file of list){if(!/\.txt$/i.test(file.name))throw new Error('اختر ملفات TXT فقط.');if(file.size>5*1024*1024)throw new Error('الملف '+file.name+' أكبر من 5 ميجابايت.');try{groups.push({name:file.name.replace(/\.txt$/i,''),questions:ExamTextImport.parseAiken(ExamTextImport.decode(await file.arrayBuffer()))});}catch(err){throw new Error(file.name+': '+err.message);}}addImported(groups);}catch(err){notice(err.message,true);}finally{$('uploadBtn').disabled=false;$('uploadFile').value='';}}
function validate(models,kind){const errors=[];for(const [mi,m]of state.models.entries()){if(!models.includes(m))continue;const sectionError=sectionIssue(m);if(sectionError)errors.push({model:mi,section:true,text:sectionError});if(m.questions.length!==requiredCount())errors.push({model:mi,text:modelTitle(m)+': '+EXAM_TYPES[state.examType].label+' يتطلب '+requiredCount()+' سؤالًا، والعدد الحالي '+m.questions.length+'.'});if(!m.questions.length)errors.push({model:mi,text:m.name+': أضف سؤالًا.'});m.questions.forEach((q,i)=>{const prefix=modelTitle(m)+'، السؤال '+(i+1)+': ';if(!line(q.text))errors.push({model:mi,q:i,text:prefix+'أدخل نص السؤال.'});if(kind==='aiken'&&(/^[A-Z][.)]\s/.test(line(q.text))||/^ANSWER:/.test(line(q.text))))errors.push({model:mi,q:i,text:prefix+'ابدأ بنص السؤال بدل A. أو ANSWER: حتى لا يلتبس مع سطور آيكن.'});if(kind==='report'&&!outcomeReady(q.clo))errors.push({model:mi,q:i,text:prefix+'اختر ناتجًا من النواتج المحددة للاختبار.'});if(kind==='aiken'||state.settings.choices){if(q.options.some(o=>!line(o))||new Set(q.options.map(line)).size!==4)errors.push({model:mi,q:i,text:prefix+'أكمل أربعة خيارات مختلفة.'});}if((kind==='aiken'||state.settings.answers)&&!letters.includes(q.answer))errors.push({model:mi,q:i,text:prefix+'اختر الإجابة الصحيحة.'});});}return errors;}
function showIssue(errors){const err=errors[0];switchModel(err.model);go(2);if(err.section){const input=$('reviewAssignments').querySelector('[data-model-section="'+err.model+'"]');if(input)input.focus();}if(err.q!==undefined){expanded.add(err.q);renderQuestions();}notice(err.text+(errors.length>1?' وتوجد '+(errors.length-1)+' ملاحظات أخرى.':''),true);if(currentCourse()?.issues.length||!selectedCourseOutcomes().length)$('outcomePanel').open=true;}
function aiken(model){return model.questions.map(q=>[line(q.text),...q.options.map((o,i)=>letters[i]+'. '+line(o)),'ANSWER: '+q.answer].join('\n')).join('\n\n')+'\n';}
function filename(s){return (line(s)||'exam').replace(/[<>:"/\\|?*\u0000-\u001f\u007f]/g,'-').replace(/[\u200e\u200f\u202a-\u202e\u2066-\u2069]/g,'').replace(/[. ]+$/g,'');}
function fileStem(model){
 const custom=line(model.name)&&line(model.name)!==modelTitle(model)?line(model.name):'';
 const parts=[state.meta.code,state.meta.course,state.meta.exam,modelTitle(model),custom,line(model.section)?'شعبة-'+line(model.section):'',state.meta.academicYear,state.meta.author,state.meta.date].map(filename).filter((s,i)=>s&&!(s==='exam'&&i>2));
 const encoder=new TextEncoder();while(encoder.encode(parts.join('_')).length>230){let at=-1,size=0;for(let i=0;i<parts.length;i++){const length=Array.from(parts[i]).length;if(length>size&&length>6){at=i;size=length;}}if(at<0)break;parts[at]=Array.from(parts[at]).slice(0,-1).join('');}
 return parts.join('_')||'exam';
}
function modelMetadata(model){return {courseCode:state.meta.code,courseName:state.meta.course,examTitle:state.meta.exam,examType:EXAM_TYPES[state.examType].label,requiredQuestionCount:requiredCount(),modelCode:model.letter,modelName:model.name,section:line(model.section),academicYear:state.meta.academicYear||'',preparedBy:state.meta.author,date:state.meta.date,semester:currentCourse()?.semesterTitle||'',creditHours:currentCourse()?.credits??null,questionCount:model.questions.length,learningOutcomes:selectedCourseOutcomes().map(o=>({code:o.code,text:o.text,domain:o.domain}))};}
const EXPORT_KEY='exam-report-exports-v1';
let exportHistory=[];try{const saved=JSON.parse(localStorage.getItem(EXPORT_KEY));if(Array.isArray(saved))exportHistory=saved.filter(r=>r&&typeof r.id==='string'&&typeof r.filename==='string'&&typeof r.content==='string'&&r.metadata&&typeof r.metadata.courseName==='string').slice(0,20);}catch{}
function makeExportRecord(model){return {id:Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,10),filename:fileStem(model)+'_Aiken.txt',createdAt:new Date().toISOString(),metadata:modelMetadata(model),content:aiken(model)};}
function rememberExports(records){
 const seen=new Set();const next=[...records,...exportHistory].filter(r=>{if(seen.has(r.id))return false;seen.add(r.id);return true;}).slice(0,20);while(next.length>1&&JSON.stringify(next).length>1000000)next.pop();
 try{const data=JSON.stringify(next);if(data.length>1000000)throw new Error('large');localStorage.setItem(EXPORT_KEY,data);exportHistory=next;renderExportHistory();return true;}catch{return false;}
}
function renderExportHistory(){
 $('exportHistory').innerHTML=exportHistory.length?exportHistory.map(r=>`<article class="saved-export"><strong dir="auto">${esc(r.filename)}</strong><span>${esc(r.metadata.courseName)} · النموذج ${esc(r.metadata.modelCode||'—')} · ${esc(r.metadata.examTitle||'')} · ${esc(r.metadata.date||'')} · شعبة ${esc(r.metadata.section||'—')}</span><button class="small" data-download-export="${esc(r.id)}">تنزيل آيكن مجددًا</button></article>`).join(''):'<p class="empty-hint">بعد تصدير آيكن ستظهر الملفات هنا للتنزيل مجددًا.</p>';
